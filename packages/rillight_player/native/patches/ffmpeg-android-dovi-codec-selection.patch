+static char *mediacodec_find_dolby_decoder(AVCodecContext *avctx, FFAMediaFormat *format)
+{
+    int32_t profile = 0;
+    /* Android profiles are single bits, not HEVC profile_idc values. */
+    if (!ff_AMediaFormat_getInt32(format, "profile", &profile) ||
+        profile <= 0 || (profile & (profile - 1)))
+        return NULL;
+    return ff_AMediaCodecList_getCodecNameByType("video/dolby-vision", profile, 0, avctx);
+}
