@@ -699,6 +699,18 @@ static int open_url(AVFormatContext *s, AVIOContext **pb, const char *url,
     if (!proto_name)
         proto_name = avio_find_protocol_name(url);
 
+    /* Custom IO may intentionally omit FFmpeg's built-in network protocols.
+     * Classify HTTP URLs so the application-owned io_open can authorize and
+     * read playlists, keys, and segments without enabling direct network IO. */
+    if (s->flags & AVFMT_FLAG_CUSTOM_IO) {
+        const char *nested = url;
+        av_strstart(nested, "crypto+", &nested);
+        if (av_strstart(nested, "http://", NULL))
+            proto_name = "http";
+        else if (av_strstart(nested, "https://", NULL))
+            proto_name = "https";
+    }
+
     if (!proto_name)
         return AVERROR_INVALIDDATA;
 
@@ -1847,6 +1859,17 @@ restart:
 
