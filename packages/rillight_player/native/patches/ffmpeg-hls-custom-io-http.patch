+        v->input->error = 0;
+        v->input->eof_reached = 0;
+        return ret;
+    }
+    if (ret < 0 && ret != AVERROR_EOF &&
+        (v->parent->flags & AVFMT_FLAG_CUSTOM_IO))
+        return ret;
