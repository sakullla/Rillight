+// Android KEY_STRIDE is bytes, KEY_SLICE_HEIGHT is rows. Validate both
+// planes before copying; padding/cropping must never read outside BufferInfo.
+static int mediacodec_copy_p010(AVCodecContext *avctx, MediaCodecDecContext *s,
+                               const uint8_t *data, size_t size,
+                               const FFAMediaCodecBufferInfo *info, AVFrame *frame)
+{
+    size_t offsets[2], row_bytes[2], rows[2], end, available;
+    if (!data || info->offset < 0 || info->size < 0 ||
+        (size_t)info->offset > size || (size_t)info->size > size - info->offset ||
+        s->stride <= 0 || s->slice_height <= 0 || s->crop_left < 0 || s->crop_top < 0 ||
+        (s->crop_left & 1) || (s->crop_top & 1) ||
+        avctx->width <= 0 || avctx->height <= 0 ||
+        (int64_t)s->crop_left + avctx->width > s->width ||
+        (int64_t)s->crop_top + avctx->height > s->slice_height)
+        return AVERROR_INVALIDDATA;
+    row_bytes[0] = (size_t)avctx->width * 2;
+    row_bytes[1] = ((size_t)avctx->width + 1) / 2 * 4;
+    rows[0] = avctx->height;
+    rows[1] = ((size_t)avctx->height + 1) / 2;
+    if ((size_t)s->stride < (size_t)s->crop_left * 2 + row_bytes[1])
+        return AVERROR_INVALIDDATA;
+    offsets[0] = (size_t)s->crop_top * s->stride + (size_t)s->crop_left * 2;
+    offsets[1] = (size_t)s->slice_height * s->stride +
+                 (size_t)(s->crop_top / 2) * s->stride + (size_t)s->crop_left * 2;
+    available = info->size;
+    for (int plane = 0; plane < 2; plane++) {
+        end = offsets[plane] + (rows[plane] - 1) * s->stride + row_bytes[plane];
+        if (end < offsets[plane] || end > available ||
+            frame->linesize[plane] < row_bytes[plane])
+            return AVERROR_INVALIDDATA;
+    }
+    for (int plane = 0; plane < 2; plane++)
+        for (size_t row = 0; row < rows[plane]; row++)
+            memcpy(frame->data[plane] + row * frame->linesize[plane],
+                   data + info->offset + offsets[plane] + row * s->stride, row_bytes[plane]);
+    return 0;
+}
