+static void mediacodec_dovi_reset(MediaCodecH264DecContext *s)
+{
+    for (int i = 0; i < s->dovi_count; i++)
+        av_free(s->dovi_frames[i].metadata);
+    s->dovi_count = s->dovi_bytes = 0;
+    if (s->ctx)
+        s->ctx->discard_before_us = s->export_dovi ? s->discard_before_us : -1;
+    ff_dovi_ctx_flush(&s->dovi);
+}
+
+static int mediacodec_dovi_packet(AVCodecContext *avctx, const AVPacket *packet)
+{
+    MediaCodecH264DecContext *s = avctx->priv_data;
+    AVDOVIMetadata *metadata = NULL;
+    int ret, has_picture = 0, has_rpu = 0;
+    if (!s->export_dovi)
+        return 0;
+    ret = ff_h2645_packet_split(&s->dovi_nals, packet->data, packet->size,
+                               avctx, 0, AV_CODEC_ID_HEVC, 0);
+    if (ret < 0)
+        return ret;
+    for (int i = 0; i < s->dovi_nals.nb_nals; i++) {
+        const H2645NAL *nal = &s->dovi_nals.nals[i];
+        if (nal->nuh_layer_id)
+            continue;
+        if (nal->type <= 31)
+            has_picture = 1;
+        if (nal->type == 62 && nal->size > 2) {
+            // Use unescaped RBSP, just as the native HEVC decoder does.
+            ret = ff_dovi_rpu_parse(&s->dovi, nal->data + 2, nal->size - 2,
+                                    avctx->err_recognition);
+            if (ret < 0)
+                return ret;
+            has_rpu = 1;
+        }
+    }
+    if (!has_picture || !has_rpu)
+        return 0;
+    // Missing presentation timestamps cannot safely associate reordered output.
+    if (packet->pts == AV_NOPTS_VALUE || !avctx->pkt_timebase.num ||
+        !avctx->pkt_timebase.den)
+        return AVERROR_INVALIDDATA;
+    if (s->discard_before_us >= 0 &&
+        av_rescale_q(packet->pts, avctx->pkt_timebase, AV_TIME_BASE_Q) < s->discard_before_us)
+        return 0; // Parse reference RPU state, but do not retain discarded preroll.
+    ret = ff_dovi_get_metadata(&s->dovi, &metadata);
+    if (ret <= 0)
+        return ret < 0 ? ret : AVERROR_INVALIDDATA;
+    if (ret > MC_DOVI_MAX_BYTES) {
+        av_free(metadata);
+        return AVERROR(ENOBUFS);
+    }
+    // Codecs may discard a damaged prefix before the first complete keyframe.
+    // Keep bounded recent metadata instead of accumulating those lost outputs.
+    // If an evicted timestamp later appears, receive still rejects the frame:
+    // never attach metadata belonging to a different presentation timestamp.
+    while (s->dovi_count && (s->dovi_count == MC_DOVI_MAX_PENDING ||
+                            ret > MC_DOVI_MAX_BYTES - s->dovi_bytes)) {
+        s->dovi_bytes -= s->dovi_frames[0].size;
+        av_free(s->dovi_frames[0].metadata);
+        memmove(s->dovi_frames, s->dovi_frames + 1,
+                --s->dovi_count * sizeof(s->dovi_frames[0]));
+    }
+    s->dovi_frames[s->dovi_count++] = (MediaCodecDoviFrame) {
+        .pts_us = av_rescale_q(packet->pts, avctx->pkt_timebase, AV_TIME_BASE_Q),
+        .metadata = (uint8_t *)metadata,
+        .size = ret,
+    };
+    s->dovi_bytes += ret;
+    return 0;
+}
+
+static int mediacodec_dovi_receive(AVCodecContext *avctx, AVFrame *frame, int wait)
+{
+    MediaCodecH264DecContext *s = avctx->priv_data;
+    int ret = ff_mediacodec_dec_receive(avctx, s->ctx, frame, wait);
+    int64_t pts_us;
+    if (ret < 0 || !s->export_dovi)
+        return ret;
+    // A timestamp match, never the most recently parsed RPU, handles B frames.
+    pts_us = av_rescale_q(frame->pts, avctx->pkt_timebase, AV_TIME_BASE_Q);
+    for (int i = 0; i < s->dovi_count; i++) {
+        MediaCodecDoviFrame *entry = &s->dovi_frames[i];
+        AVFrameSideData *side;
+        if (entry->pts_us != pts_us)
+            continue;
+        if (frame->format != AV_PIX_FMT_P010LE) {
+            av_frame_unref(frame);
+            return AVERROR_INVALIDDATA;
+        }
+        side = av_frame_new_side_data(frame, AV_FRAME_DATA_DOVI_METADATA, entry->size);
+        if (!side)
+            return AVERROR(ENOMEM);
+        memcpy(side->data, entry->metadata, entry->size);
+        s->dovi_bytes -= entry->size;
+        av_free(entry->metadata);
+        memmove(entry, entry + 1, (--s->dovi_count - i) * sizeof(*entry));
+        // Profile 5 IPT is full range; ordinary YUV range conversion corrupts it.
+        frame->color_range = AVCOL_RANGE_JPEG;
+        frame->color_primaries = AVCOL_PRI_BT2020;
+        return 0;
+    }
+    av_frame_unref(frame);
+    return AVERROR_INVALIDDATA;
+}
+#else
