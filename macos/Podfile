platform :osx, '12.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated = File.expand_path(File.join('Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __dir__)
  raise "Missing #{generated}; run flutter pub get first" unless File.exist?(generated)
  File.foreach(generated) do |line|
    match = line.match(/FLUTTER_ROOT\=(.*)/)
    return match[1].strip if match
  end
  raise "FLUTTER_ROOT missing from #{generated}"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!
  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      minimum = config.build_settings['MACOSX_DEPLOYMENT_TARGET'] || '12.0'
      if Gem::Version.new(minimum) < Gem::Version.new('12.0')
        config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '12.0'
      end
      next unless target.name == 'rillight_player'
      flags = config.build_settings['OTHER_LDFLAGS']
      flags = flags.nil? ? ['$(inherited)'] : Array(flags)
      flags << '-framework FlutterMacOS' unless flags.any? { |flag| flag.to_s.include?('FlutterMacOS') }
      config.build_settings['OTHER_LDFLAGS'] = flags
    end
  end
end
